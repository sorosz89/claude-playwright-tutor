{
  "name": "claude-tutor",
  "version": "1.0.0",
  "description": "Playwright + TypeScript test automation, with hands-on GenAI challenges comparing @anthropic-ai/sdk vs LangChain.js, against Playwright's hosted TodoMVC demo.",
  "type": "commonjs",
  "scripts": {
    "test": "playwright test tests/",
    "test:challenge1": "cross-env LLM_PROVIDER=anthropic playwright test challenges/01-ai-test-case-generator",
    "test:challenge1:langchain": "cross-env LLM_PROVIDER=langchain playwright test challenges/01-ai-test-case-generator",
    "test:challenge2": "cross-env LLM_PROVIDER=anthropic playwright test challenges/02-self-healing-locators",
    "test:challenge2:langchain": "cross-env LLM_PROVIDER=langchain playwright test challenges/02-self-healing-locators",
    "test:challenge3": "cross-env LLM_PROVIDER=anthropic playwright test challenges/03-exploratory-testing-agent",
    "test:challenge3:langchain": "cross-env LLM_PROVIDER=langchain playwright test challenges/03-exploratory-testing-agent",
    "test:challenge4": "cross-env LLM_PROVIDER=anthropic playwright test challenges/04-production-self-healing-locators",
    "test:challenge4:langchain": "cross-env LLM_PROVIDER=langchain playwright test challenges/04-production-self-healing-locators",
    "test:all": "playwright test",
    "typecheck": "tsc -p .",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint",
    "report": "playwright show-report"
  },
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.7",
    "eslint": "^10.12.0",
    "eslint-plugin-playwright": "^2.12.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@langchain/anthropic": "^1.0.0",
    "@langchain/core": "^1.0.0",
    "zod": "^4.1.0"
  }
}
