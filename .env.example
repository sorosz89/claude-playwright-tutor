# Required for challenges/ only — the baseline tests/ suite needs no API key.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-haiku-4-5-20251001 (fast/cheap — good for
# iterating on the challenges, where you'll be calling the API a lot).
# Swap in claude-sonnet-5 for higher-quality generations if you want.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional. Which implementation the challenge specs call into: "anthropic" or "langchain".
LLM_PROVIDER=anthropic
